# ----------------------------------------------------
# Activation du mod_rewrite et routage vers index.php
# ----------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Rediriger vers non-www (exemple pour domaine.com)
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^(.*)$ https://%1/$1 [L,R=301]
  
  # Redirige la racine du site vers /public/
  RewriteRule ^$ public/ [L]

  # Sinon, si le fichier ou dossier n'existe pas dans /public, router vers index.php
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ public/index.php [QSA,L]
</IfModule>

# ----------------------------------------------------
# Optimisation du cache
# ----------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png  "access plus 1 year"
  ExpiresByType image/jpg  "access plus 1 year"
  ExpiresByType image/gif  "access plus 1 year"
  ExpiresByType text/css   "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|jpg|jpeg|png|gif)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# ----------------------------------------------------
# Sécurité renforcée
# ----------------------------------------------------

# Interdire l'indexation du dossier
Options -Indexes

# Bloquer l'accès aux fichiers sensibles
<FilesMatch "(^\.|composer\.(json|lock)|\.env|README|phpunit\.xml|webpack\.config\.js|package\.json)">
  Require all denied
</FilesMatch>

# Empêcher l’exécution de PHP dans /uploads (si ce dossier existe)
<Directory "/uploads">
  <FilesMatch "\.php$">
    Require all denied
  </FilesMatch>
</Directory>

# Headers de sécurité
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-XSS-Protection "1; mode=block"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
</IfModule>

