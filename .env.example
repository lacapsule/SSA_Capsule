# Copier en .env (jamais versionné). En local, aucune valeur n'est obligatoire : SQLite et e-mails dans data/.
APP_ENV=local
# Adresse publique du site, sans slash final (liens envoyés par e-mail).
APP_URL=
# Production : 64 caractères aléatoires, par exemple php -r "echo bin2hex(random_bytes(32));"
APP_KEY=

# Production : MySQL ou MariaDB de l'hébergeur
DB_DSN=
DB_USER=
DB_PASSWORD=

# Sauvegardes chiffrées (modules/sauvegarde-chiffree). Obligatoire hors APP_ENV=local : sans elle, aucune sauvegarde
# n'est créée. Créée par « php scripts/sauvegarde.php cle --ecrire » ; en garder une copie HORS du serveur
# (gestionnaire de mots de passe), jamais à côté des sauvegardes.
BACKUP_KEY=
# Copie hors du serveur (php scripts/sauvegarde.php copier) ; {fichier} est remplacé par le chemin de la sauvegarde.
BACKUP_REMOTE=
